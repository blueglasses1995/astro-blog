# Copy this file to `.env.local` (recommended) or `.env`
# and fill in the values.
#
# - `.env*` files are loaded from the project root (same level as package.json)
# - Variables prefixed with `PUBLIC_` are exposed to the browser in Astro.

## ----------------------------
## i18n / content pipeline
## ----------------------------

# Source language for your markdown posts (used by preprocess/translate scripts)
SOURCE_LOCALE=ja

# Target locales for translation scripts (comma-separated)
TARGET_LOCALES=en,zh,th,de,fr,es

# Related posts generation (default: 5)
MAX_RELATED_POSTS=5

## ----------------------------
## AI (translation / image alt / related posts)
## ----------------------------

# Choose one: openai | anthropic | gemini
AI_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Gemini
GEMINI_API_KEY=

## ----------------------------
## Contact form (Resend)
## ----------------------------

RESEND_API_KEY=
CONTACT_EMAIL=

## ----------------------------
## Public site metadata (exposed to browser)
## ----------------------------

PUBLIC_SITE_URL=
PUBLIC_GITHUB_REPO_URL=
