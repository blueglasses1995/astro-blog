{
  "name": "astro-blog",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "preprocess": "tsx scripts/preprocess-blog.ts",
    "translate": "tsx scripts/translate-posts.ts",
    "related": "tsx scripts/generate-related-posts.ts",
    "image-alt": "tsx scripts/generate-image-alt.ts",
    "prebuild": "npm run preprocess && npm run translate && npm run related",
    "build": "npm run prebuild && astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "npm run build && npx wrangler pages deploy dist --project-name=astro-blog"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.0",
    "@astrojs/cloudflare": "^11.2.0",
    "@astrojs/react": "^3.6.0",
    "@astrojs/tailwind": "^5.1.0",
    "@expressive-code/plugin-collapsible-sections": "^0.41.5",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.0",
    "astro": "^4.15.0",
    "astro-expressive-code": "^0.41.5",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^11.11.0",
    "gray-matter": "^4.0.3",
    "hast-util-to-string": "^3.0.1",
    "html2pdf.js": "^0.12.1",
    "lucide-react": "^0.441.0",
    "react": "^18.3.1",
    "react-day-picker": "^9.13.0",
    "react-dom": "^18.3.1",
    "rehype-slug": "^6.0.0",
    "resend": "^6.6.0",
    "tailwind-merge": "^2.5.2",
    "tailwindcss": "^3.4.1",
