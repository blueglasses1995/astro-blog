---
import '../styles/globals.css';
import { Navigation } from '../components/Navigation';
import { LanguageSwitcher } from '../components/LanguageSwitcher';
import { ThemeToggle } from '../components/ThemeToggle';
import { LiquidGlassEffect } from '../components/LiquidGlassEffect';
import { getLocaleFromPath, getPathWithoutLocale, defaultLocale, supportedLocales } from '../i18n/utils';
import { getTranslations } from '../i18n';
import type { SupportedLocale } from '../types';
import { generateMetaDescription, generateHreflangTags, generateStructuredData, generateCanonicalUrl, getSiteName } from '../lib/seo-utils';
import { ChatWidget } from '../components/chat/ChatWidget';

interface Props {
  title: string;
  description?: string;
  author?: string;
  pubDate?: string;
  updatedDate?: string;
  availableLocales?: string[];
  slug?: string;
}

const { title, description = '', author, pubDate, updatedDate, availableLocales, slug } = Astro.props;
const currentYear = new Date().getFullYear();

// Get current locale from URL
const currentPath = Astro.url.pathname;
const locale: SupportedLocale = getLocaleFromPath(currentPath);
const translations = getTranslations(locale);
const pathWithoutLocale = getPathWithoutLocale(currentPath);

// Generate SEO metadata
const metaDescription = generateMetaDescription(title, description);
const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://example.com';
const hreflangTags = availableLocales 
  ? generateHreflangTags(slug || '', availableLocales, defaultLocale)
  : [];
const canonicalUrl = generateCanonicalUrl(currentPath);
const siteName = getSiteName();
const structuredData = pubDate && author
  ? generateStructuredData(title, description, author, pubDate, updatedDate)
  : null;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={metaDescription} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />

    {/* hreflang tags for multilingual support */}
    {hreflangTags.length > 0 && hreflangTags.map(tag => (
      <link rel={tag.rel} hreflang={tag.hreflang} href={tag.href} />
    ))}
    
    {/* Open Graph / Facebook */}
    <meta property="og:type" content={pubDate ? "article" : "website"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={locale} />
    
    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    
    {/* Structured Data (JSON-LD) */}
    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
    
    {/* Theme initialization script - prevents FOUC */}
    <script is:inline>
      (function() {
        const storedTheme = localStorage.getItem('theme');
        const root = document.documentElement;
        
        if (storedTheme === 'dark') {
          root.classList.add('dark');
        } else if (storedTheme === 'light') {
          root.classList.remove('dark');
        } else {
          // 保存されたテーマがない場合、システム設定を使用
          const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (systemPrefersDark) {
            root.classList.add('dark');
          } else {
            root.classList.remove('dark');
          }
        }
      })();
    </script>
  </head>
  <body>
    <div class="liquid-glass-container">
      <div class="liquid-glass-bg"></div>
      <LiquidGlassEffect client:load />
      <div class="min-h-screen relative">
      <header class="sticky top-0 z-50 border-b liquid-glass backdrop-blur-md supports-[backdrop-filter]:backdrop-blur-md">
        <div class="container mx-auto px-4 py-4">
          <nav class="flex items-center justify-between">
            <a href={locale === defaultLocale ? '/' : `/${locale}`} class="text-2xl font-serif font-bold text-foreground hover:text-foreground/80 transition-colors tracking-tight">
              Portfolio
            </a>
            <div class="flex items-center gap-2 sm:gap-4">
              <Navigation client:load locale={locale} translations={translations} />
              <ThemeToggle client:load />
              <LanguageSwitcher client:load currentLocale={locale} currentPath={pathWithoutLocale} />
            </div>
          </nav>
        </div>
      </header>
      <main>
        <slot />
      </main>
      <footer class="border-t mt-12 sm:mt-16 md:mt-20 liquid-glass backdrop-blur-md">
        <div class="container mx-auto px-4 py-8 sm:py-10 md:py-12">
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 sm:gap-8 mb-8">
            <div>
              <h3 class="font-serif font-bold text-lg mb-4">Portfolio</h3>
              <p class="text-sm text-muted-foreground">
                {translations.footer.description}
              </p>
            </div>
            <div>
              <h3 class="font-serif font-bold text-lg mb-4">{translations.common.links}</h3>
              <ul class="space-y-2 text-sm">
                <li><a href={locale === defaultLocale ? '/' : `/${locale}`} class="text-muted-foreground hover:text-primary transition-colors">{translations.nav.home}</a></li>
                <li><a href={locale === defaultLocale ? '/about' : `/${locale}/about`} class="text-muted-foreground hover:text-primary transition-colors">{translations.nav.about}</a></li>
                <li><a href={locale === defaultLocale ? '/portfolio' : `/${locale}/portfolio`} class="text-muted-foreground hover:text-primary transition-colors">{translations.nav.portfolio}</a></li>
                <li><a href={locale === defaultLocale ? '/cv' : `/${locale}/cv`} class="text-muted-foreground hover:text-primary transition-colors">{translations.nav.cv}</a></li>
                <li><a href={locale === defaultLocale ? '/blog' : `/${locale}/blog`} class="text-muted-foreground hover:text-primary transition-colors">{translations.nav.blog}</a></li>
              </ul>
            </div>
            <div>
              <h3 class="font-serif font-bold text-lg mb-4">{translations.common.techStack}</h3>
              <ul class="space-y-2 text-sm text-muted-foreground">
                <li>Astro</li>
                <li>React</li>
                <li>Framer Motion</li>
                <li>Three.js</li>
                <li>TailwindCSS</li>
                <li>shadcn/ui</li>
              </ul>
            </div>
          </div>
          <div class="text-center text-sm text-muted-foreground border-t pt-8">
            <p>© {currentYear} Portfolio. {translations.common.allRightsReserved}</p>
          </div>
        </div>
      </footer>
      <ChatWidget client:only="react" />
      </div>
    </div>
  </body>
</html>
