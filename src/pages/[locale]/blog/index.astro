---
import Layout from '../../../layouts/Layout.astro';
import { BlogFilterPanel, type BlogListItem, type BlogFilterPanelLabels } from '../../../components/BlogFilterPanel';
import { getTranslations } from '../../../i18n';
import { supportedLocales, defaultLocale, getLocalizedPath } from '../../../i18n/utils';
import type { SupportedLocale } from '../../../types';
import { filterDrafts } from '../../../lib/blog';

export async function getStaticPaths() {
  return supportedLocales
    .filter((locale) => locale !== defaultLocale)
    .map((locale) => ({
      params: { locale },
      props: { locale },
    }));
}

const { locale } = Astro.props;
const translations = getTranslations(locale);

const posts = filterDrafts(await Astro.glob('../../../content/blog/*.md'));
const blogPosts: BlogListItem[] = posts
  .map((post) => {
    const frontmatter = post.frontmatter ?? {};
    const createdDate = frontmatter.date ?? frontmatter.pubDate ?? '';
    const updatedDate = frontmatter.updatedDate ?? createdDate;
    const slug = frontmatter.slug ?? post.file?.split('/').pop()?.replace('.md', '') ?? '';

    return {
      title: frontmatter.title ?? slug,
      description: frontmatter.description ?? '',
      date: createdDate,
      updatedDate,
      readTime: frontmatter.readTime,
      tags: frontmatter.tags ?? [],
      slug,
      category: frontmatter.category,
      subcategory: frontmatter.subcategory,
    } satisfies BlogListItem;
  })
  .filter((post) => Boolean(post.slug && post.title && post.date))
  .sort((a, b) => new Date(b.updatedDate ?? b.date).getTime() - new Date(a.updatedDate ?? a.date).getTime());

const filterLabels: BlogFilterPanelLabels = {
  helperText: translations.blog.filters.helperText,
  resultCountText: translations.blog.filters.resultCountText,
  resetButton: translations.blog.filters.resetButton,
  sortLabel: translations.blog.filters.sortLabel,
  dateTargetLabel: translations.blog.filters.dateTargetLabel,
  startDateLabel: translations.blog.filters.startDateLabel,
  endDateLabel: translations.blog.filters.endDateLabel,
  categoriesLabel: translations.blog.filters.categoriesLabel,
  tagsLabel: translations.blog.filters.tagsLabel,
  emptyState: translations.blog.filters.emptyState,
  categoryFallback: translations.blog.filters.categoryFallback,
  tagPrefix: translations.blog.filters.tagPrefix,
  sortOptionLabels: {
    'updated-desc': translations.blog.filters.sort.updatedDesc,
    'updated-asc': translations.blog.filters.sort.updatedAsc,
    'created-desc': translations.blog.filters.sort.createdDesc,
    'created-asc': translations.blog.filters.sort.createdAsc,
  },
  dateFilterOptionLabels: {
    updated: translations.blog.filters.dateModes.updated,
    created: translations.blog.filters.dateModes.created,
  },
};
---

<Layout title={`${translations.blog.title} | Tech Blog`}>
  <section class="container mx-auto px-4 py-8 sm:py-12 md:py-16">
    <div class="text-center mb-8 sm:mb-10 md:mb-12">
      <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl font-bold mb-4 tracking-tight">{translations.blog.title}</h1>
      <div class="editorial-divider mb-4"></div>
      <p class="text-base sm:text-lg text-muted-foreground">{translations.blog.description}</p>
    </div>
    <div class="flex flex-wrap gap-3 justify-center mb-8 sm:mb-10">
      <a href={getLocalizedPath('/skills', locale)} class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-border bg-card text-sm font-medium text-muted-foreground hover:text-crimson-500 hover:border-crimson-500/50 transition-all">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" /></svg>
        {translations.home.skillTree}
      </a>
      <a href={getLocalizedPath('/graph', locale)} class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-border bg-card text-sm font-medium text-muted-foreground hover:text-crimson-700 hover:border-crimson-700/50 transition-all">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 14.25v2.25m3-4.5v4.5m3-6.75v6.75m3-9v9M6 20.25h12A2.25 2.25 0 0020.25 18V6A2.25 2.25 0 0018 3.75H6A2.25 2.25 0 003.75 6v12A2.25 2.25 0 006 20.25z" /></svg>
        {translations.home.knowledgeGraph}
      </a>
    </div>
    <BlogFilterPanel client:load posts={blogPosts} labels={filterLabels} locale={locale} />
  </section>
</Layout>
