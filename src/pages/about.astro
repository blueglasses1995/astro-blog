---
import Layout from '../layouts/Layout.astro';
import { TimelineItem } from '../components/TimelineItem';
import { SkillCard } from '../components/SkillCard';
import { ContactForm } from '../components/ContactForm';
import { FadeIn } from '../components/animations/FadeIn';
import { SlideIn } from '../components/animations/SlideIn';
import { Card, CardContent, CardHeader, CardTitle } from '../components/ui/card';
import { Mail, MapPin, Github, Linkedin, X } from 'lucide-react';
import { profile, skills, experiences, education } from '../data/profile';
import { getLocaleFromPath } from '../i18n/utils';
import { getTranslations } from '../i18n';
import { supportedLocales, defaultLocale } from '../i18n/utils';
import type { SupportedLocale } from '../types';

export async function getStaticPaths() {
  return supportedLocales.map((locale) => ({
    params: { locale: locale === defaultLocale ? undefined : locale },
    props: { locale },
  }));
}

const { locale } = Astro.props;
const translations = getTranslations(locale);

// スキルをカテゴリーごとにグループ化
const skillsByCategory = {
  frontend: skills.filter(s => s.category === 'frontend'),
  backend: skills.filter(s => s.category === 'backend'),
  database: skills.filter(s => s.category === 'database'),
  devops: skills.filter(s => s.category === 'devops'),
  testing: skills.filter(s => s.category === 'testing'),
  design: skills.filter(s => s.category === 'design'),
  ai: skills.filter(s => s.category === 'ai'),
};
---

<Layout title={`${translations.about.title} | tosh.sh`} description={profile.bio}>
  <!-- Profile Header -->
  <section class="container mx-auto px-4 py-10 sm:py-16 md:py-20">
    <FadeIn client:load>
      <div class="max-w-4xl mx-auto text-center mb-10 sm:mb-12 md:mb-16">
        <div class="relative w-24 h-24 sm:w-32 sm:h-32 mx-auto mb-6">
          <div class="w-full h-full rounded-full bg-gradient-to-br from-crimson-700 to-crimson-400 p-1">
            <div class="w-full h-full rounded-full bg-background flex items-center justify-center text-4xl font-bold">
              {profile.name.charAt(0)}
            </div>
          </div>
        </div>
        <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl font-bold mb-3 sm:mb-4 tracking-tight">{profile.name}</h1>
        <p class="text-lg sm:text-xl md:text-2xl text-primary mb-4 sm:mb-6">{profile.title}</p>
        <p class="text-base sm:text-lg md:text-xl text-muted-foreground max-w-2xl mx-auto leading-relaxed">
          {profile.bio}
        </p>
      </div>
    </FadeIn>

    <!-- Contact Info -->
    <div class="max-w-3xl mx-auto">
      <SlideIn client:load direction="up">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
          <Card>
            <CardContent className="p-6">
              <div class="flex items-center gap-3">
                <Mail className="w-5 h-5 text-primary" />
                <div>
                  <p class="text-sm text-muted-foreground">{translations.cv.sendEmail}</p>
                  <a href={`mailto:${profile.email}`} class="text-foreground hover:text-primary transition-colors">
                    {profile.email}
                  </a>
                </div>
              </div>
            </CardContent>
          </Card>
          <Card>
            <CardContent className="p-6">
              <div class="flex items-center gap-3">
                <MapPin className="w-5 h-5 text-primary" />
                <div>
                  <p class="text-sm text-muted-foreground">Location</p>
                  <p class="text-foreground">{profile.location}</p>
                </div>
              </div>
            </CardContent>
          </Card>
        </div>
      </SlideIn>

      <SlideIn client:load direction="up" delay={0.1}>
        <div class="flex flex-wrap justify-center gap-3 sm:gap-4">
          {profile.github && (
            <a
              href={profile.github}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 px-4 py-2 rounded-lg border border-border hover:border-primary hover:bg-primary/5 transition-colors"
            >
              <Github className="w-5 h-5" />
              GitHub
            </a>
          )}
          {profile.twitter && (
            <a
              href={profile.twitter}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 px-4 py-2 rounded-lg border border-border hover:border-primary hover:bg-primary/5 transition-colors"
            >
              <X className="w-5 h-5" />
              Twitter
            </a>
          )}
          {profile.linkedin && (
            <a
              href={profile.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 px-4 py-2 rounded-lg border border-border hover:border-primary hover:bg-primary/5 transition-colors"
            >
              <Linkedin className="w-5 h-5" />
              LinkedIn
            </a>
          )}
        </div>
      </SlideIn>
    </div>
  </section>

  <!-- Skills -->
  <section class="container mx-auto px-4 py-10 sm:py-16 md:py-20 bg-muted/30">
    <FadeIn client:load>
      <div class="text-center mb-8 sm:mb-10 md:mb-12">
        <h2 class="font-serif text-2xl sm:text-3xl md:text-4xl font-bold mb-4 tracking-tight">{translations.about.skills}</h2>
        <div class="editorial-divider mb-4"></div>
        <p class="text-base sm:text-lg text-muted-foreground max-w-xl mx-auto">{translations.about.skillsDesc}</p>
      </div>
    </FadeIn>

    <div class="max-w-6xl mx-auto space-y-8 sm:space-y-10 md:space-y-12">
      <!-- Frontend -->
      <div>
        <h3 class="text-2xl font-bold mb-6 text-primary">{translations.about.frontend}</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {skillsByCategory.frontend.map((skill, index) => (
            <SkillCard client:load skill={skill} index={index} />
          ))}
        </div>
      </div>

      <!-- Backend -->
      <div>
        <h3 class="text-2xl font-bold mb-6 text-green-500">{translations.about.backend}</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {skillsByCategory.backend.map((skill, index) => (
            <SkillCard client:load skill={skill} index={index} />
          ))}
        </div>
      </div>

      <!-- Database -->
      {skillsByCategory.database.length > 0 && (
      <div>
        <h3 class="text-2xl font-bold mb-6 text-amber-500">{translations.about.database}</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {skillsByCategory.database.map((skill, index) => (
            <SkillCard client:load skill={skill} index={index} />
          ))}
        </div>
      </div>
      )}

      <!-- DevOps -->
      {skillsByCategory.devops.length > 0 && (
      <div>
        <h3 class="text-2xl font-bold mb-6 text-orange-500">{translations.about.devops}</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {skillsByCategory.devops.map((skill, index) => (
            <SkillCard client:load skill={skill} index={index} />
          ))}
        </div>
      </div>
      )}

      <!-- Testing -->
      {skillsByCategory.testing.length > 0 && (
      <div>
        <h3 class="text-2xl font-bold mb-6 text-cyan-500">{translations.about.testing}</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {skillsByCategory.testing.map((skill, index) => (
            <SkillCard client:load skill={skill} index={index} />
          ))}
        </div>
      </div>
      )}

      <!-- AI -->
      {skillsByCategory.ai && skillsByCategory.ai.length > 0 && (
      <div>
        <h3 class="text-2xl font-bold mb-6 text-violet-500">{translations.about.ai}</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {skillsByCategory.ai.map((skill, index) => (
            <SkillCard client:load skill={skill} index={index} />
          ))}
        </div>
      </div>
      )}

      <!-- Design -->
      {skillsByCategory.design.length > 0 && (
      <div>
        <h3 class="text-2xl font-bold mb-6 text-purple-500">{translations.about.design}</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {skillsByCategory.design.map((skill, index) => (
            <SkillCard client:load skill={skill} index={index} />
          ))}
        </div>
      </div>
      )}
    </div>
  </section>

  <!-- Experience Timeline -->
  <section class="container mx-auto px-4 py-10 sm:py-16 md:py-20">
    <FadeIn client:load>
      <div class="text-center mb-10 sm:mb-12 md:mb-16">
        <h2 class="font-serif text-2xl sm:text-3xl md:text-4xl font-bold mb-4 tracking-tight">{translations.about.experience}</h2>
        <div class="editorial-divider mb-4"></div>
        <p class="text-base sm:text-lg text-muted-foreground max-w-xl mx-auto">{translations.about.experienceDesc}</p>
      </div>
    </FadeIn>

    <div class="max-w-4xl mx-auto">
      {experiences.map((experience, index) => (
        <TimelineItem
          client:load
          experience={experience}
          index={index}
          isLast={index === experiences.length - 1}
        />
      ))}
    </div>
  </section>

  <!-- Education -->
  <section class="container mx-auto px-4 py-10 sm:py-16 md:py-20 bg-muted/30">
    <FadeIn client:load>
      <div class="text-center mb-8 sm:mb-10 md:mb-12">
        <h2 class="font-serif text-2xl sm:text-3xl md:text-4xl font-bold mb-4 tracking-tight">{translations.about.education}</h2>
        <div class="editorial-divider mb-4"></div>
        <p class="text-base sm:text-lg text-muted-foreground max-w-xl mx-auto">{translations.about.educationDesc}</p>
      </div>
    </FadeIn>

    <div class="max-w-4xl mx-auto space-y-6">
      {education.map((edu) => (
        <SlideIn client:load direction="left">
          <Card>
            <CardHeader>
              <CardTitle className="text-xl">{edu.degree}</CardTitle>
              <div class="flex flex-wrap items-center gap-2 text-muted-foreground">
                <span class="font-medium">{edu.school}</span>
                <span>•</span>
                <span>{edu.period}</span>
              </div>
            </CardHeader>
            {edu.description && (
              <CardContent>
                <p class="text-muted-foreground">{edu.description}</p>
              </CardContent>
            )}
          </Card>
        </SlideIn>
      ))}
    </div>
  </section>

  <!-- Contact Form -->
  <section class="container mx-auto px-4 py-10 sm:py-16 md:py-20">
    <FadeIn client:load>
      <div class="text-center mb-8 sm:mb-10 md:mb-12">
        <h2 class="font-serif text-2xl sm:text-3xl md:text-4xl font-bold mb-4 tracking-tight">{translations.common.contact}</h2>
        <div class="editorial-divider mb-4"></div>
        <p class="text-base sm:text-lg text-muted-foreground max-w-xl mx-auto">{translations.cv.contactDesc}</p>
      </div>
    </FadeIn>
    <ContactForm client:load locale={locale} />
  </section>
</Layout>
