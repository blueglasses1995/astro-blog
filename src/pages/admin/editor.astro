---
import Layout from '../../layouts/Layout.astro';
import { ArticleEditor } from '../../components/editor/ArticleEditor';

export const prerender = false;

const url = new URL(Astro.request.url);
const token = url.searchParams.get('token');
const isAuthorized = token === 'demo';
---

<Layout title="Article Editor | Tech Blog">
  <section class="container mx-auto px-4 py-8 sm:py-12">
    {isAuthorized ? (
      <div>
        <div class="mb-6">
          <h1 class="font-serif text-2xl sm:text-3xl font-bold text-foreground tracking-tight">Article Editor</h1>
          <p class="text-sm text-muted-foreground mt-1">Write and analyze your article in real-time.</p>
          <div class="editorial-divider mt-3 !mx-0"></div>
        </div>
        <div class="min-h-[60vh]">
          <ArticleEditor client:load />
        </div>
      </div>
    ) : (
      <div class="flex flex-col items-center justify-center min-h-[50vh] text-center">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground/50 mb-4">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
          <path d="M7 11V7a5 5 0 0 1 10 0v4" />
        </svg>
        <h1 class="font-serif text-2xl font-bold text-foreground mb-2">Unauthorized</h1>
        <p class="text-sm text-muted-foreground max-w-sm">
          Access to the editor requires a valid token. Please provide a <code class="px-1.5 py-0.5 rounded bg-muted text-xs">?token=</code> parameter in the URL.
        </p>
      </div>
    )}
  </section>
</Layout>
