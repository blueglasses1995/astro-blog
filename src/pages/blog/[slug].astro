---
import Layout from '../../layouts/Layout.astro';
import { Badge } from '../../components/ui/badge';
import { Calendar, Clock, Github, X as XIcon } from 'lucide-react';
import { profile } from '../../data/profile';
import { BlogTree } from '../../components/BlogTree';
import TableOfContents from '../../components/TableOfContents.astro';
import MarkdownContent from '../../components/markdown/MarkdownContent.astro';
import { ToggleableHeading } from '../../components/ToggleableHeading';
import { ToggleableCodeBlock } from '../../components/ToggleableCodeBlock';
import { HeadingLinkIcon } from '../../components/HeadingLinkIcon';
import { RelatedPosts } from '../../components/RelatedPosts';

export async function getStaticPaths() {
  const posts = await Astro.glob('../../content/blog/*.md');
  const paths = posts.map((post: any) => {
    const frontmatter = post.frontmatter ?? {};
    const slug = frontmatter.slug ?? post.file?.split('/').pop()?.replace('.md', '') ?? '';
    const fileName = post.file?.split('/').pop() || '';
    
    if (!slug) {
      return null; // Skip posts without slug
    }
    
    return {
      params: { slug },
      props: { post, fileName },
    };
  }).filter(Boolean);
  
  return paths;
}

const { post, fileName } = Astro.props;
const { Content } = post;
const { title, description, date: rawDate, readTime, tags, author, category } = post.frontmatter;
const headings = (await (post as any).getHeadings?.()) ?? [];
const slug = post.frontmatter?.slug ?? Astro.params.slug ?? fileName.replace(/\.md$/, '');

// 日付を YYYY-MM-DD 形式にフォーマット
const formatDate = (dateValue: string | Date | undefined): string => {
  if (!dateValue) {
    return new Date().toISOString().split('T')[0];
  }
  if (dateValue instanceof Date) {
    return dateValue.toISOString().split('T')[0];
  }
  // 文字列の場合：ISO形式の文字列から日付部分だけを抽出
  if (typeof dateValue === 'string') {
    // ISO形式（2024-12-01T00:00:00.000Z）から日付部分だけを取得
    const dateMatch = dateValue.match(/^(\d{4}-\d{2}-\d{2})/);
    if (dateMatch) {
      return dateMatch[1];
    }
    // その他の形式の場合、Dateオブジェクトに変換してからフォーマット
    const parsedDate = new Date(dateValue);
    if (!isNaN(parsedDate.getTime())) {
      return parsedDate.toISOString().split('T')[0];
    }
  }
  // フォールバック
  return new Date().toISOString().split('T')[0];
};

const date = formatDate(rawDate);

// Get all posts for the blog tree
const allPosts = await Astro.glob('../../content/blog/*.md');
const blogTreePosts = allPosts.map((p: any) => {
  const frontmatter = p.frontmatter ?? {};
  return {
    title: frontmatter.title ?? '',
    slug: frontmatter.slug ?? p.file?.split('/').pop()?.replace('.md', '') ?? '',
    category: frontmatter.category,
    subcategory: frontmatter.subcategory,
  };
}).filter((p: any) => p.slug && p.title);

// Calculate related posts based on tags
const currentTags = tags || [];
const relatedPostsData = allPosts
  .map((p: any) => {
    const frontmatter = p.frontmatter ?? {};
    const postSlug = frontmatter.slug ?? p.file?.split('/').pop()?.replace('.md', '') ?? '';
    const postTags = frontmatter.tags || [];
    
    // Skip current post
    if (postSlug === slug) {
      return null;
    }
    
    // Calculate tag overlap
    const currentTagsSet = new Set(currentTags.map((t: string) => t.toLowerCase()));
    const postTagsSet = new Set(postTags.map((t: string) => t.toLowerCase()));
    const matchingTags = [...currentTagsSet].filter(tag => postTagsSet.has(tag));
    
    if (matchingTags.length === 0) {
      return null;
    }
    
    // Format date properly
    let postDate: string | Date = '';
    if (frontmatter.date) {
      postDate = frontmatter.date instanceof Date 
        ? frontmatter.date.toISOString().split('T')[0]
        : frontmatter.date;
    } else if (frontmatter.pubDate) {
      postDate = frontmatter.pubDate instanceof Date
        ? frontmatter.pubDate.toISOString().split('T')[0]
        : frontmatter.pubDate;
    }
    
    return {
      slug: postSlug,
      title: frontmatter.title ?? '',
      description: frontmatter.description ?? '',
      date: postDate,
      readTime: frontmatter.readTime,
      tags: postTags,
      category: frontmatter.category,
      matchCount: matchingTags.length,
    };
  })
  .filter((p: any) => p !== null)
  .sort((a: any, b: any) => b.matchCount - a.matchCount)
  .slice(0, 3); // Show top 3 related posts

// Get repository URL from profile or environment variable
const repositoryUrl = import.meta.env.PUBLIC_GITHUB_REPO_URL || 
  (profile.github ? `${profile.github}/astro-blog` : 'https://github.com/yourusername/astro-blog');

// Construct GitHub file URL
const githubFileUrl = `${repositoryUrl}/blob/main/src/content/blog/${fileName}`;

// Construct article URL for sharing
const articleUrl = new URL(`/blog/${slug}`, Astro.url.origin).toString();

// Construct X (Twitter) share URL
const xShareUrl = `https://x.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(articleUrl)}`;
---

<Layout title={`${title} | Tech Blog`} description={description}>
  <div class="container mx-auto px-4 py-8 sm:py-12 md:py-16 max-w-7xl">
    <div class="flex flex-col lg:flex-row gap-6 lg:gap-10">
      <aside class="hidden lg:block w-64 shrink-0">
        <div class="sticky top-24 space-y-4">
          <div class="rounded-lg border border-border bg-background/60 backdrop-blur p-4">
            <TableOfContents headings={headings} />
          </div>
          <div class="rounded-lg border border-border bg-background/60 backdrop-blur p-4">
            <BlogTree posts={blogTreePosts} currentSlug={slug} locale="ja" />
          </div>
        </div>
      </aside>

      <article class="min-w-0 flex-1 max-w-4xl">
        <header class="mb-8">
      {category && (
        <div class="flex items-center gap-2 mb-4">
          <div class="w-8 h-[2px] bg-crimson-500"></div>
          <a href={`/categories/${category}`} class="no-underline text-xs font-medium tracking-widest uppercase text-crimson-600 dark:text-crimson-400 hover:opacity-80 transition-opacity">
            {category}
          </a>
        </div>
      )}
      <h1 class="font-serif text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold mb-3 sm:mb-4 tracking-tight leading-tight">{title}</h1>
      <p class="text-base sm:text-lg md:text-xl text-muted-foreground mb-4 sm:mb-6">{description}</p>
      <div class="flex flex-wrap items-center gap-2 mb-4">
        {tags.map((tag: string) => (
          <a href={`/tags/${tag}`} class="no-underline">
            <Badge client:idle variant="secondary" className="text-[10px] px-2 py-0 font-normal hover:opacity-80 transition-opacity">
              {tag}
            </Badge>
          </a>
        ))}
      </div>
      <div class="flex flex-wrap items-center gap-3 text-xs text-muted-foreground border-t border-border/50 pt-4">
        <span class="font-medium">{author}</span>
        <span class="text-border">|</span>
        <span>{date}</span>
        {readTime && (
          <>
            <span class="text-border">|</span>
            <span>{readTime}</span>
          </>
        )}
      </div>
        </header>
        <MarkdownContent content={Content} />
        <div class="mt-8 pt-8 border-t border-border">
          <div class="flex items-center gap-4 flex-wrap">
            <a 
              href={githubFileUrl} 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-3 py-1.5 rounded-md border border-primary/30 bg-primary/10 text-primary hover:bg-primary/15 hover:border-primary/40 transition-colors no-underline"
            >
              <Github className="h-4 w-4" />
              <span>GitHubで見る</span>
            </a>
            <a 
              href={xShareUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-3 py-1.5 rounded-md border border-[#1DA1F2] bg-[#1DA1F2]/10 text-[#1DA1F2] hover:bg-[#1DA1F2]/20 hover:border-[#1a8cd8] transition-colors no-underline"
              aria-label="Xでシェア"
            >
              <XIcon className="h-4 w-4 stroke-[#1DA1F2]" strokeWidth={2} />
              <span>Xでシェア</span>
            </a>
          </div>
        </div>
        {relatedPostsData.length > 0 && (
          <RelatedPosts 
            client:load
            posts={relatedPostsData}
            currentSlug={slug}
          />
        )}
      </article>
    </div>
  </div>
</Layout>
