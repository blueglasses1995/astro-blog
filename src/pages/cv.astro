---
import Layout from '../layouts/Layout.astro';
import { Button } from '../components/ui/button';
import { FadeIn } from '../components/animations/FadeIn';
import { SlideIn } from '../components/animations/SlideIn';
import { ContactForm } from '../components/ContactForm';
import { Download, Mail, MapPin, Github, Linkedin, ChevronDown } from 'lucide-react';
import { profile, education, skills } from '../data/profile';
import { cvProjects } from '../data/cv-details';
import { getLocaleFromPath } from '../i18n/utils';
import { getTranslations } from '../i18n';
import type { SupportedLocale } from '../types';

const locale: SupportedLocale = getLocaleFromPath(Astro.url.pathname);
const translations = getTranslations(locale);

const skillCategories = [
  { key: 'frontend', label: translations.about.frontend, color: 'text-primary', bg: 'bg-primary/10' },
  { key: 'backend', label: translations.about.backend, color: 'text-green-600', bg: 'bg-green-600/10' },
  { key: 'database', label: translations.about.database, color: 'text-blue-600', bg: 'bg-blue-600/10' },
  { key: 'devops', label: translations.about.devops, color: 'text-orange-600', bg: 'bg-orange-600/10' },
  { key: 'testing', label: translations.about.testing, color: 'text-yellow-600', bg: 'bg-yellow-600/10' },
  { key: 'ai', label: translations.about.ai, color: 'text-purple-600', bg: 'bg-purple-600/10' },
];
---

<Layout title={`${translations.cv.title} | tosh.sh`} description={`${profile.name} — ${translations.cv.workExperience}`}>
  <style is:global>
    @media print {
      header, footer, .no-print { display: none !important; }
      .print-full-width { max-width: 100% !important; }
      details { open: true; }
      details[open] summary { display: none; }
      * { color-adjust: exact; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    }
    details > summary { cursor: pointer; list-style: none; }
    details > summary::-webkit-details-marker { display: none; }
    details > summary::before {
      content: '▶';
      display: inline-block;
      margin-right: 0.5rem;
      font-size: 0.7em;
      transition: transform 0.2s;
    }
    details[open] > summary::before { transform: rotate(90deg); }
    details > summary:hover { opacity: 0.8; }
    .task-card { transition: all 0.2s; }
    .task-card:hover { background-color: hsl(var(--accent)); }
    .difficulty-extreme { color: #dc2626; font-weight: 600; }
    .difficulty-high { color: #ea580c; font-weight: 600; }
    .difficulty-medium { color: #ca8a04; }
    .difficulty-low { color: #16a34a; }
  </style>

  <div class="container mx-auto px-4 py-8 sm:py-10 md:py-12 print-full-width">
    <!-- Download Button -->
    <div class="no-print mb-8 text-center">
      <FadeIn client:load>
        <Button id="download-pdf-btn" size="lg">
          <Download className="w-5 h-5 mr-2" />
          {translations.cv.downloadPDF}
        </Button>
      </FadeIn>
    </div>

    <div id="cv-content" class="max-w-5xl mx-auto bg-background border rounded-lg p-4 sm:p-8 md:p-10 lg:p-12 shadow-lg">
      <!-- Header -->
      <header class="mb-8 sm:mb-10">
        <FadeIn client:load>
          <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl font-bold mb-2 tracking-tight">{profile.name}</h1>
          <p class="text-lg sm:text-xl md:text-2xl text-primary mb-4 sm:mb-6">{profile.title}</p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
            <div class="flex items-center gap-2">
              <Mail className="w-4 h-4 text-muted-foreground" />
              <a href={`mailto:${profile.email}`} class="hover:text-primary transition-colors">{profile.email}</a>
            </div>
            <div class="flex items-center gap-2">
              <MapPin className="w-4 h-4 text-muted-foreground" />
              <span>{profile.location}</span>
            </div>
            {profile.github && (
              <div class="flex items-center gap-2">
                <Github className="w-4 h-4 text-muted-foreground" />
                <a href={profile.github} target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-colors truncate">{profile.github.replace('https://', '')}</a>
              </div>
            )}
            {profile.linkedin && (
              <div class="flex items-center gap-2">
                <Linkedin className="w-4 h-4 text-muted-foreground" />
                <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-colors truncate">{profile.linkedin.replace('https://', '')}</a>
              </div>
            )}
          </div>
        </FadeIn>
      </header>

      <!-- Summary -->
      <section class="mb-8 sm:mb-10">
        <h2 class="text-2xl font-bold mb-4 border-b pb-2">{translations.cv.profile}</h2>
        <p class="text-muted-foreground leading-relaxed">{translations.hero.bio}</p>
      </section>

      <!-- Skills -->
      <section class="mb-8 sm:mb-10">
        <h2 class="text-2xl font-bold mb-6 border-b pb-2">{translations.cv.skills}</h2>
        <div class="space-y-4">
          {skillCategories.map(cat => {
            const catSkills = skills.filter(s => s.category === cat.key);
            return catSkills.length > 0 && (
              <div>
                <h3 class={`font-semibold text-sm mb-2 ${cat.color}`}>{cat.label}</h3>
                <div class="flex flex-wrap gap-1.5">
                  {catSkills.map(skill => (
                    <span class={`px-2.5 py-0.5 ${cat.bg} ${cat.color} rounded-full text-xs font-medium`}>
                      {skill.name}
                    </span>
                  ))}
                </div>
              </div>
            );
          })}
        </div>
      </section>

      <!-- Work Experience - All Projects -->
      <section class="mb-8 sm:mb-10">
        <h2 class="text-2xl font-bold mb-6 border-b pb-2">
          {translations.cv.workExperience}
          <span class="text-sm font-normal text-muted-foreground ml-2">{translations.cv.allProjects.replace('{count}', String(cvProjects.length))}</span>
        </h2>

        <div class="flex flex-col gap-4">
          {cvProjects.map((project, pIdx) => (
            <div class="border rounded-lg overflow-hidden">
              <!-- Project Header -->
              <details class="group">
                <summary class="flex flex-col sm:flex-row sm:items-center gap-2 p-4 sm:p-5 hover:bg-accent/50 transition-colors">
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2 flex-wrap">
                      <h3 class="text-lg font-bold">{project.role}</h3>
                      {project.teamSize && (
                        <span class="text-xs px-2 py-0.5 bg-muted rounded-full text-muted-foreground">{translations.cv.members.replace('{count}', String(project.teamSize))}</span>
                      )}
                    </div>
                    <div class="text-sm text-muted-foreground mt-1">
                      <span class="font-medium">{project.company}</span>
                      <span class="mx-1.5">•</span>
                      <span>{project.period}</span>
                    </div>
                    <p class="text-sm text-muted-foreground mt-2 leading-relaxed line-clamp-2">{project.summary}</p>
                  </div>
                  <div class="text-xs text-muted-foreground whitespace-nowrap self-start sm:self-center">
                    {translations.cv.tasks.replace('{count}', String(project.tasks.length))}
                  </div>
                </summary>

                <!-- Expanded: Tasks -->
                <div class="border-t px-4 sm:px-5 py-4 bg-muted/20 space-y-3">
                  <!-- Technologies -->
                  <div class="flex flex-wrap gap-1.5 mb-4">
                    {project.technologies.map(tech => (
                      <span class="px-2 py-0.5 bg-secondary text-secondary-foreground rounded text-xs font-medium">{tech}</span>
                    ))}
                  </div>

                  <!-- Tasks List -->
                  {project.tasks.map((task, tIdx) => (
                    <details class="task-card rounded-md border bg-background">
                      <summary class="p-3 text-sm">
                        <span class="font-semibold">{task.title}</span>
                        {task.difficulty && (
                          <span class={`ml-2 text-xs difficulty-${task.difficulty}`}>
                            {task.difficulty === 'extreme' ? translations.cv.difficultyExtreme : task.difficulty === 'high' ? translations.cv.difficultyHigh : task.difficulty === 'medium' ? translations.cv.difficultyMedium : translations.cv.difficultyLow}
                          </span>
                        )}
                      </summary>

                      <div class="px-3 pb-3 space-y-3 text-sm">
                        <!-- Summary -->
                        {task.summary && (
                          <p class="text-muted-foreground leading-relaxed">{task.summary}</p>
                        )}

                        <!-- Task Technologies -->
                        {task.technologies.length > 0 && (
                          <div class="flex flex-wrap gap-1">
                            {task.technologies.map(t => (
                              <span class="px-1.5 py-0.5 bg-primary/10 text-primary rounded text-xs">{t}</span>
                            ))}
                          </div>
                        )}

                        <!-- Highlights / Contributions -->
                        {task.highlights.length > 0 && (
                          <div>
                            <h5 class="font-semibold text-xs text-muted-foreground uppercase tracking-wider mb-1.5">{translations.cv.contributions}</h5>
                            <ul class="space-y-1">
                              {task.highlights.map(h => (
                                <li class="flex gap-2 text-sm leading-relaxed">
                                  <span class="text-primary mt-1 shrink-0">•</span>
                                  <span>{h}</span>
                                </li>
                              ))}
                            </ul>
                          </div>
                        )}

                        <!-- Decisions -->
                        {task.decisions && task.decisions.length > 0 && (
                          <details class="rounded border-l-2 border-blue-500 bg-blue-50 dark:bg-blue-950/20">
                            <summary class="p-2 text-xs font-semibold text-blue-700 dark:text-blue-400">
                              {translations.cv.decisions} ({task.decisions.length})
                            </summary>
                            <div class="px-2 pb-2 space-y-2">
                              {task.decisions.map(d => (
                                <div class="text-xs">
                                  <p class="font-medium">{d.title}</p>
                                  <p class="text-muted-foreground mt-0.5">{d.detail}</p>
                                </div>
                              ))}
                            </div>
                          </details>
                        )}

                        <!-- Outcomes -->
                        {task.outcomes && task.outcomes.length > 0 && (
                          <details class="rounded border-l-2 border-green-500 bg-green-50 dark:bg-green-950/20">
                            <summary class="p-2 text-xs font-semibold text-green-700 dark:text-green-400">
                              {translations.cv.outcomes} ({task.outcomes.length})
                            </summary>
                            <div class="px-2 pb-2 space-y-2">
                              {task.outcomes.map(o => (
                                <div class="text-xs space-y-0.5">
                                  {o.before && <p><span class="text-muted-foreground">Before:</span> {o.before}</p>}
                                  {o.after && <p><span class="text-green-600 dark:text-green-400 font-medium">After:</span> {o.after}</p>}
                                  {o.metric && <p class="text-muted-foreground italic">{o.metric}</p>}
                                </div>
                              ))}
                            </div>
                          </details>
                        )}

                        <!-- Challenges -->
                        {task.challenges && task.challenges.length > 0 && (
                          <details class="rounded border-l-2 border-amber-500 bg-amber-50 dark:bg-amber-950/20">
                            <summary class="p-2 text-xs font-semibold text-amber-700 dark:text-amber-400">
                              {translations.cv.challenges} ({task.challenges.length})
                            </summary>
                            <div class="px-2 pb-2 space-y-2">
                              {task.challenges.map(c => (
                                <div class="text-xs">
                                  <p class="font-medium">{c.title}</p>
                                  <p class="text-muted-foreground mt-0.5">{c.resolution}</p>
                                </div>
                              ))}
                            </div>
                          </details>
                        )}
                      </div>
                    </details>
                  ))}
                </div>
              </details>
            </div>
          ))}
        </div>
      </section>

      <!-- Education -->
      <section class="mb-8 sm:mb-10">
        <h2 class="text-2xl font-bold mb-6 border-b pb-2">{translations.cv.education}</h2>
        <div class="flex flex-col gap-4">
          {education.map(edu => (
            <div class="relative pl-8 border-l-2 border-primary/30">
              <div class="absolute -left-2 top-0 w-4 h-4 rounded-full bg-primary" />
              <div>
                <h3 class="text-xl font-bold mb-1">{edu.degree}</h3>
                <div class="flex items-center gap-2 text-muted-foreground mb-2">
                  <span class="font-medium">{edu.school}</span>
                  <span>•</span>
                  <span>{edu.period}</span>
                </div>
                {edu.description && (
                  <p class="text-muted-foreground leading-relaxed">{edu.description}</p>
                )}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Footer Note -->
      <footer class="text-center text-sm text-muted-foreground border-t pt-6">
        <p>{translations.cv.asOf} <span class="font-semibold">{new Date().toLocaleDateString('ja-JP')}</span></p>
      </footer>
    </div>

    <!-- Contact Form -->
    <div class="no-print mt-12">
      <FadeIn client:load>
        <ContactForm client:load locale={locale} />
      </FadeIn>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', async () => {
      const downloadBtn = document.getElementById('download-pdf-btn');
      const cvContent = document.getElementById('cv-content');

      if (downloadBtn && cvContent) {
        downloadBtn.addEventListener('click', async () => {
          try {
            // Open all details before PDF export
            const allDetails = cvContent.querySelectorAll('details');
            allDetails.forEach(d => d.setAttribute('open', ''));

            const html2pdf = (await import('html2pdf.js')).default;
            const opt = {
              margin: [8, 8, 8, 8],
              filename: 'tosh_CV.pdf',
              image: { type: 'jpeg', quality: 0.95 },
              html2canvas: { scale: 2, useCORS: true, letterRendering: true },
              jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' },
              pagebreak: { mode: ['avoid-all', 'css', 'legacy'] }
            };

            // @ts-ignore
            await html2pdf().set(opt).from(cvContent).save();

            // Close details after export
            allDetails.forEach(d => d.removeAttribute('open'));
          } catch (error) {
            console.error('PDF generation error:', error);
          }
        });
      }
    });
  </script>
</Layout>
