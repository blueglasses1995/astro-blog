---
import Layout from '../layouts/Layout.astro';
import { Card, CardContent, CardHeader, CardTitle } from '../components/ui/card';
import { Button } from '../components/ui/button';
import { FadeIn } from '../components/animations/FadeIn';
import { SlideIn } from '../components/animations/SlideIn';
import { ContactForm } from '../components/ContactForm';
import { Download, Mail, MapPin, Github, Linkedin } from 'lucide-react';
import { profile, experiences, education, skills } from '../data/profile';
import { getLocaleFromPath } from '../i18n/utils';
import type { SupportedLocale } from '../types';

const locale: SupportedLocale = getLocaleFromPath(Astro.url.pathname);
---

<Layout title="CV / 履歴書 | tosh.sh" description={`${profile.name}の履歴書・職務経歴書`}>
  <!-- Print Styles -->
  <style is:global>
    @media print {
      header, footer, .no-print {
        display: none !important;
      }
      .print-full-width {
        max-width: 100% !important;
      }
      * {
        color-adjust: exact;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
    }
  </style>

  <div class="container mx-auto px-4 py-8 sm:py-10 md:py-12 print-full-width">
    <!-- Download Button -->
    <div class="no-print mb-8 text-center">
      <FadeIn client:load>
        <Button id="download-pdf-btn" size="lg">
          <Download className="w-5 h-5 mr-2" />
          PDFとしてダウンロード
        </Button>
      </FadeIn>
    </div>

    <div id="cv-skill-banner" class="hidden mb-6 items-center justify-between px-4 py-2.5 rounded-lg border-l-4 border-crimson-500 bg-crimson-500/10 max-w-4xl mx-auto">
      <span class="text-sm font-medium text-foreground">
        Highlighting skill: <span id="cv-skill-name" class="text-crimson-500"></span>
      </span>
      <button id="cv-skill-clear" class="text-muted-foreground hover:text-foreground transition-colors p-1">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    </div>

    <div id="cv-content" class="max-w-4xl mx-auto bg-background border rounded-lg p-4 sm:p-8 md:p-10 lg:p-12 shadow-lg">
      <!-- Header -->
      <header class="mb-8 sm:mb-10 md:mb-12">
        <FadeIn client:load>
          <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl font-bold mb-2 tracking-tight">{profile.name}</h1>
          <p class="text-lg sm:text-xl md:text-2xl text-primary mb-4 sm:mb-6">{profile.title}</p>

          <!-- Contact Info Grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
            <div class="flex items-center gap-2">
              <Mail className="w-4 h-4 text-muted-foreground" />
              <a href={`mailto:${profile.email}`} class="hover:text-primary transition-colors">
                {profile.email}
              </a>
            </div>
            <div class="flex items-center gap-2">
              <MapPin className="w-4 h-4 text-muted-foreground" />
              <span>{profile.location}</span>
            </div>
            {profile.github && (
              <div class="flex items-center gap-2">
                <Github className="w-4 h-4 text-muted-foreground" />
                <a href={profile.github} target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-colors truncate">
                  {profile.github.replace('https://', '')}
                </a>
              </div>
            )}
            {profile.linkedin && (
              <div class="flex items-center gap-2">
                <Linkedin className="w-4 h-4 text-muted-foreground" />
                <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-colors truncate">
                  {profile.linkedin.replace('https://', '')}
                </a>
              </div>
            )}
          </div>
        </FadeIn>
      </header>

      <!-- Summary -->
      <section class="mb-8 sm:mb-10 md:mb-12">
        <SlideIn client:load direction="left">
          <h2 class="text-2xl font-bold mb-4 border-b pb-2">プロフィール</h2>
          <p class="text-muted-foreground leading-relaxed">{profile.bio}</p>
        </SlideIn>
      </section>

      <!-- Skills -->
      <section class="mb-8 sm:mb-10 md:mb-12">
        <SlideIn client:load direction="left" delay={0.1}>
          <h2 class="text-2xl font-bold mb-6 border-b pb-2">スキル</h2>

          <div class="space-y-6">
            <!-- Frontend -->
            <div>
              <h3 class="font-semibold text-lg mb-3 text-primary">フロントエンド</h3>
              <div class="flex flex-wrap gap-2">
                {skills.filter(s => s.category === 'frontend').map(skill => (
                  <span class="px-3 py-1 bg-primary/10 text-primary rounded-full text-sm font-medium">
                    {skill.name}
                  </span>
                ))}
              </div>
            </div>

            <!-- Backend -->
            <div>
              <h3 class="font-semibold text-lg mb-3 text-green-600">バックエンド</h3>
              <div class="flex flex-wrap gap-2">
                {skills.filter(s => s.category === 'backend').map(skill => (
                  <span class="px-3 py-1 bg-green-600/10 text-green-600 rounded-full text-sm font-medium">
                    {skill.name}
                  </span>
                ))}
              </div>
            </div>

            <!-- DevOps -->
            <div>
              <h3 class="font-semibold text-lg mb-3 text-orange-600">DevOps</h3>
              <div class="flex flex-wrap gap-2">
                {skills.filter(s => s.category === 'devops').map(skill => (
                  <span class="px-3 py-1 bg-orange-600/10 text-orange-600 rounded-full text-sm font-medium">
                    {skill.name}
                  </span>
                ))}
              </div>
            </div>

            <!-- Design -->
            {skills.filter(s => s.category === 'design').length > 0 && (
              <div>
                <h3 class="font-semibold text-lg mb-3 text-purple-600">デザイン</h3>
                <div class="flex flex-wrap gap-2">
                  {skills.filter(s => s.category === 'design').map(skill => (
                    <span class="px-3 py-1 bg-purple-600/10 text-purple-600 rounded-full text-sm font-medium">
                      {skill.name}
                    </span>
                  ))}
                </div>
              </div>
            )}
          </div>
        </SlideIn>
      </section>

      <!-- Work Experience -->
      <section class="mb-8 sm:mb-10 md:mb-12">
        <SlideIn client:load direction="left" delay={0.2}>
          <h2 class="text-2xl font-bold mb-6 border-b pb-2">職務経歴</h2>
        </SlideIn>

        <div class="flex flex-col gap-6">
          {experiences.map((exp, index) => (
            <SlideIn client:load direction="left" delay={index * 0.1}>
              <div class="relative pl-8 border-l-2 border-primary/30 cv-experience" data-technologies={JSON.stringify(exp.technologies)}>
                <div class="absolute -left-2 top-0 w-4 h-4 rounded-full bg-primary" />
                <div>
                  <h3 class="text-xl font-bold mb-1">{exp.title}</h3>
                  <div class="flex items-center gap-2 text-muted-foreground mb-2">
                    <span class="font-medium">{exp.company}</span>
                    <span>•</span>
                    <span>{exp.period}</span>
                  </div>
                  <p class="text-muted-foreground mb-3 leading-relaxed">{exp.description}</p>
                  <div class="flex flex-wrap gap-2">
                    {exp.technologies.map(tech => (
                      <span class="px-2 py-1 bg-secondary text-secondary-foreground rounded text-xs font-medium cv-tech-badge" data-tech={tech}>
                        {tech}
                      </span>
                    ))}
                  </div>
                </div>
              </div>
            </SlideIn>
          ))}
        </div>
      </section>

      <!-- Education -->
      <section class="mb-8 sm:mb-10 md:mb-12">
        <SlideIn client:load direction="left" delay={0.3}>
          <h2 class="text-2xl font-bold mb-6 border-b pb-2">学歴</h2>
        </SlideIn>

        <div class="flex flex-col gap-6">
          {education.map((edu, index) => (
            <SlideIn client:load direction="left" delay={index * 0.1}>
              <div class="relative pl-8 border-l-2 border-primary/30">
                <div class="absolute -left-2 top-0 w-4 h-4 rounded-full bg-primary" />
                <div>
                  <h3 class="text-xl font-bold mb-1">{edu.degree}</h3>
                  <div class="flex items-center gap-2 text-muted-foreground mb-2">
                    <span class="font-medium">{edu.school}</span>
                    <span>•</span>
                    <span>{edu.period}</span>
                  </div>
                  {edu.description && (
                    <p class="text-muted-foreground leading-relaxed">{edu.description}</p>
                  )}
                </div>
              </div>
            </SlideIn>
          ))}
        </div>
      </section>

      <!-- Footer Note -->
      <footer class="text-center text-sm text-muted-foreground border-t pt-6">
        <p>このCVは <span class="font-semibold">{new Date().toLocaleDateString('ja-JP')}</span> 時点のものです</p>
      </footer>
    </div>

    <!-- Contact Form -->
    <div class="no-print mt-12">
      <FadeIn client:load>
        <ContactForm client:load locale={locale} />
      </FadeIn>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', async () => {
      const downloadBtn = document.getElementById('download-pdf-btn');
      const cvContent = document.getElementById('cv-content');

      if (downloadBtn && cvContent) {
        downloadBtn.addEventListener('click', async () => {
          try {
            // 動的インポートでhtml2pdf.jsを読み込む
            const html2pdf = (await import('html2pdf.js')).default;

            // PDF生成のオプション設定
            const opt = {
              margin: [10, 10, 10, 10],
              filename: '職務経歴書.pdf',
              image: { type: 'jpeg', quality: 0.98 },
              html2canvas: {
                scale: 2,
                useCORS: true,
                letterRendering: true
              },
              jsPDF: {
                unit: 'mm',
                format: 'a4',
                orientation: 'portrait'
              }
            };

            // PDFを生成してダウンロード
            // @ts-ignore
            html2pdf().set(opt).from(cvContent).save();
          } catch (error) {
            console.error('PDF生成エラー:', error);
            alert('PDFの生成に失敗しました。もう一度お試しください。');
          }
        });
      }

      // Skill highlighting from URL param
      const urlParams = new URLSearchParams(window.location.search);
      const skillParam = urlParams.get('skill');

      if (skillParam) {
        const banner = document.getElementById('cv-skill-banner');
        const skillName = document.getElementById('cv-skill-name');
        const clearBtn = document.getElementById('cv-skill-clear');

        if (banner && skillName) {
          banner.classList.remove('hidden');
          banner.classList.add('flex');
          skillName.textContent = skillParam;

          const experiences = document.querySelectorAll('.cv-experience');
          experiences.forEach((exp) => {
            const techs = JSON.parse(exp.getAttribute('data-technologies') || '[]');
            const lowerSkill = skillParam.toLowerCase();
            const matches = techs.some((tech) => tech.toLowerCase().includes(lowerSkill) || lowerSkill.includes(tech.toLowerCase()));

            if (matches) {
              exp.classList.add('border-crimson-500', 'bg-crimson-500/5', 'rounded-lg', 'p-4', '-ml-4');
              exp.classList.remove('border-primary/30');

              const badges = exp.querySelectorAll('.cv-tech-badge');
              badges.forEach((badge) => {
                const tech = badge.getAttribute('data-tech') || '';
                if (tech.toLowerCase().includes(lowerSkill) || lowerSkill.includes(tech.toLowerCase())) {
                  badge.classList.add('bg-crimson-500', 'text-white');
                  badge.classList.remove('bg-secondary', 'text-secondary-foreground');
                }
              });
            } else {
              exp.style.opacity = '0.4';
            }
          });

          const firstMatch = document.querySelector('.cv-experience.border-crimson-500');
          if (firstMatch) {
            setTimeout(() => {
              firstMatch.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }, 500);
          }

          if (clearBtn) {
            clearBtn.addEventListener('click', () => {
              window.history.replaceState({}, '', window.location.pathname);
              experiences.forEach((exp) => {
                exp.classList.remove('border-crimson-500', 'bg-crimson-500/5', 'rounded-lg', 'p-4', '-ml-4');
                exp.classList.add('border-primary/30');
                exp.style.opacity = '1';
                const badges = exp.querySelectorAll('.cv-tech-badge');
                badges.forEach((badge) => {
                  badge.classList.remove('bg-crimson-500', 'text-white');
                  badge.classList.add('bg-secondary', 'text-secondary-foreground');
                });
              });
              banner.classList.add('hidden');
              banner.classList.remove('flex');
            });
          }
        }
      }
    });
  </script>
</Layout>
