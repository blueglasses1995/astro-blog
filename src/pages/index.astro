---
import Layout from '../layouts/Layout.astro';
import { Hero } from '../components/Hero';
import { FloatingShapes } from '../components/3d/FloatingShapes';
import { ProjectCard } from '../components/ProjectCard';
import { Button } from '../components/ui/button';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '../components/ui/card';
import { BlogCard } from '../components/BlogCard';
import { FadeIn } from '../components/animations/FadeIn';
import { profile, projects } from '../data/profile';

// ブログ記事を取得（MDファイルから）
const posts = await Astro.glob('../content/blog/*.md');
const sortedPosts = posts.sort((a, b) =>
  new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime()
).slice(0, 3);

// 注目のプロジェクトを取得
const featuredProjects = projects.filter(p => p.featured).slice(0, 3);
---

<Layout title="ホーム | Tech Blog">
  <!-- 3D Background -->
  <FloatingShapes client:load />

  <!-- Hero Section -->
  <Hero client:load name={profile.name} title={profile.title} bio={profile.bio} />

  <!-- Featured Projects -->
  <section class="container mx-auto px-4 py-20">
    <FadeIn client:load>
      <div class="text-center mb-12">
        <h2 class="text-4xl font-bold mb-4">注目のプロジェクト</h2>
        <p class="text-xl text-muted-foreground">最近の制作物をご覧ください</p>
      </div>
    </FadeIn>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
      {featuredProjects.map((project, index) => (
        <ProjectCard client:visible project={project} index={index} />
      ))}
    </div>
    <FadeIn client:load className="text-center">
      <Button asChild variant="outline" size="lg">
        <a href="/portfolio">すべてのプロジェクトを見る</a>
      </Button>
    </FadeIn>
  </section>

  <!-- Tech Stack -->
  <section class="container mx-auto px-4 py-20 bg-muted/30 rounded-3xl">
    <FadeIn client:load>
      <div class="text-center mb-12">
        <h2 class="text-4xl font-bold mb-4">使用技術</h2>
        <p class="text-xl text-muted-foreground">このサイトで使用している技術スタック</p>
      </div>
    </FadeIn>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      <Card client:visible>
        <CardHeader>
          <CardTitle>Astro</CardTitle>
          <CardDescription>静的サイトジェネレーター</CardDescription>
        </CardHeader>
        <CardContent>
          <p class="text-sm text-muted-foreground">
            アイランドアーキテクチャで高速なサイトを生成
          </p>
        </CardContent>
      </Card>
      <Card client:visible>
        <CardHeader>
          <CardTitle>React</CardTitle>
          <CardDescription>UIライブラリ</CardDescription>
        </CardHeader>
        <CardContent>
          <p class="text-sm text-muted-foreground">
            インタラクティブなUIコンポーネント
          </p>
        </CardContent>
      </Card>
      <Card client:visible>
        <CardHeader>
          <CardTitle>Framer Motion</CardTitle>
          <CardDescription>アニメーションライブラリ</CardDescription>
        </CardHeader>
        <CardContent>
          <p class="text-sm text-muted-foreground">
            滑らかでプロフェッショナルなアニメーション
          </p>
        </CardContent>
      </Card>
      <Card client:visible>
        <CardHeader>
          <CardTitle>Three.js</CardTitle>
          <CardDescription>3Dグラフィックス</CardDescription>
        </CardHeader>
        <CardContent>
          <p class="text-sm text-muted-foreground">
            インタラクティブな3D要素
          </p>
        </CardContent>
      </Card>
    </div>
  </section>

  <!-- Latest Blog Posts -->
  <section class="container mx-auto px-4 py-20">
    <FadeIn client:load>
      <div class="text-center mb-12">
        <h2 class="text-4xl font-bold mb-4">最新の記事</h2>
        <p class="text-xl text-muted-foreground">技術ブログの最新投稿</p>
      </div>
    </FadeIn>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {sortedPosts.map((post) => (
        <BlogCard
          client:visible
          title={post.frontmatter.title}
          description={post.frontmatter.description}
          date={post.frontmatter.date}
          readTime={post.frontmatter.readTime}
          tags={post.frontmatter.tags}
          slug={post.frontmatter.slug}
        />
      ))}
    </div>
    <FadeIn client:load className="text-center mt-8">
      <Button asChild variant="outline" size="lg">
        <a href="/blog">すべての記事を見る →</a>
      </Button>
    </FadeIn>
  </section>
</Layout>
