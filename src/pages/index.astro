---
import Layout from '../layouts/Layout.astro';
import { Hero } from '../components/Hero';
import { FloatingShapes } from '../components/3d/FloatingShapes';
import { ProjectCard } from '../components/ProjectCard';
import { Button } from '../components/ui/button';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '../components/ui/card';
import { BlogCard } from '../components/BlogCard';
import { FadeIn } from '../components/animations/FadeIn';
import { profile, projects } from '../data/profile';
import { getLocaleFromPath, getLocalizedPath, defaultLocale } from '../i18n/utils';
import { getTranslations } from '../i18n';
import type { SupportedLocale } from '../types';
import { filterDrafts } from '../lib/blog';

// Prerender this page as static HTML
export const prerender = true;

// Get current locale
const locale: SupportedLocale = getLocaleFromPath(Astro.url.pathname);
const translations = getTranslations(locale);

// ブログ記事を取得（MDファイルから）
const posts = filterDrafts(await Astro.glob('../content/blog/*.md'));
const sortedPosts = posts.sort((a, b) =>
  new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime()
).slice(0, 3);

// 注目のプロジェクトを取得
const featuredProjects = projects.filter(p => p.featured).slice(0, 3);
---

<Layout title={`${translations.home.title} | tosh.sh`}>
  <!-- 3D Background -->
  <FloatingShapes client:load />

  <!-- Hero Section -->
  <Hero client:load name={translations.hero.name} title={translations.hero.title} bio={translations.hero.bio} locale={locale} translations={translations} />

  <!-- Featured Projects -->
  <section class="container mx-auto px-4 py-10 sm:py-16 md:py-20">
    <FadeIn client:load>
      <div class="text-center mb-8 sm:mb-10 md:mb-12">
        <h2 class="font-serif text-2xl sm:text-3xl md:text-4xl font-bold mb-4 text-foreground tracking-tight">{translations.home.featuredProjects}</h2>
        <div class="editorial-divider mb-4"></div>
        <p class="text-base sm:text-lg text-muted-foreground max-w-xl mx-auto">{translations.home.featuredProjectsDesc}</p>
      </div>
    </FadeIn>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
      {featuredProjects.map((project, index) => (
        <ProjectCard client:visible project={project} index={index} />
      ))}
    </div>
    <FadeIn client:load className="text-center">
      <Button asChild variant="outline" size="lg">
        <a href={getLocalizedPath('/portfolio', locale)}>{translations.home.viewAllProjects}</a>
      </Button>
    </FadeIn>
  </section>

  <!-- Tech Stack -->
  <section class="container mx-auto px-4 py-10 sm:py-16 md:py-20 bg-muted/30 rounded-2xl sm:rounded-3xl">
    <FadeIn client:load>
      <div class="text-center mb-8 sm:mb-10 md:mb-12">
        <h2 class="font-serif text-2xl sm:text-3xl md:text-4xl font-bold mb-4 text-foreground tracking-tight">{translations.home.techStack}</h2>
        <div class="editorial-divider mb-4"></div>
        <p class="text-base sm:text-lg text-muted-foreground max-w-xl mx-auto">{translations.home.techStackDesc}</p>
      </div>
    </FadeIn>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
      <Card client:visible>
        <CardHeader>
          <CardTitle>Astro</CardTitle>
          <CardDescription>静的サイトジェネレーター</CardDescription>
        </CardHeader>
        <CardContent>
          <p class="text-sm text-muted-foreground">
            アイランドアーキテクチャで高速なサイトを生成
          </p>
        </CardContent>
      </Card>
      <Card client:visible>
        <CardHeader>
          <CardTitle>React</CardTitle>
          <CardDescription>UIライブラリ</CardDescription>
        </CardHeader>
        <CardContent>
          <p class="text-sm text-muted-foreground">
            インタラクティブなUIコンポーネント
          </p>
        </CardContent>
      </Card>
      <Card client:visible>
        <CardHeader>
          <CardTitle>Framer Motion</CardTitle>
          <CardDescription>アニメーションライブラリ</CardDescription>
        </CardHeader>
        <CardContent>
          <p class="text-sm text-muted-foreground">
            滑らかでプロフェッショナルなアニメーション
          </p>
        </CardContent>
      </Card>
      <Card client:visible>
        <CardHeader>
          <CardTitle>Three.js</CardTitle>
          <CardDescription>3Dグラフィックス</CardDescription>
        </CardHeader>
        <CardContent>
          <p class="text-sm text-muted-foreground">
            インタラクティブな3D要素
          </p>
        </CardContent>
      </Card>
    </div>
  </section>

  <!-- Knowledge Explorer -->
  <section class="container mx-auto px-4 py-10 sm:py-16 md:py-20">
    <FadeIn client:load>
      <div class="text-center mb-8 sm:mb-10 md:mb-12">
        <h2 class="font-serif text-2xl sm:text-3xl md:text-4xl font-bold mb-4 text-foreground tracking-tight">{translations.home.knowledgeExplorer}</h2>
        <div class="editorial-divider mb-4"></div>
        <p class="text-base sm:text-lg text-muted-foreground max-w-xl mx-auto">{translations.home.knowledgeExplorerDesc}</p>
      </div>
    </FadeIn>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <a href={getLocalizedPath('/skills', locale)} class="group block rounded-xl border border-border bg-card p-6 sm:p-8 hover:border-crimson-500/50 hover:shadow-lg transition-all">
        <div class="flex items-start gap-4">
          <div class="w-12 h-12 rounded-lg bg-crimson-500/10 flex items-center justify-center shrink-0">
            <svg class="w-6 h-6 text-crimson-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456z" />
            </svg>
          </div>
          <div>
            <h3 class="font-serif text-xl font-bold mb-2 text-foreground group-hover:text-crimson-500 transition-colors">{translations.home.skillTree}</h3>
            <p class="text-sm text-muted-foreground mb-4">{translations.home.skillTreeDesc}</p>
            <span class="text-sm font-medium text-crimson-500">{translations.home.viewSkillTree}</span>
          </div>
        </div>
      </a>
      <a href={getLocalizedPath('/graph', locale)} class="group block rounded-xl border border-border bg-card p-6 sm:p-8 hover:border-crimson-700/50 hover:shadow-lg transition-all">
        <div class="flex items-start gap-4">
          <div class="w-12 h-12 rounded-lg bg-crimson-700/10 flex items-center justify-center shrink-0">
            <svg class="w-6 h-6 text-crimson-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 14.25v2.25m3-4.5v4.5m3-6.75v6.75m3-9v9M6 20.25h12A2.25 2.25 0 0020.25 18V6A2.25 2.25 0 0018 3.75H6A2.25 2.25 0 003.75 6v12A2.25 2.25 0 006 20.25z" />
            </svg>
          </div>
          <div>
            <h3 class="font-serif text-xl font-bold mb-2 text-foreground group-hover:text-crimson-700 transition-colors">{translations.home.knowledgeGraph}</h3>
            <p class="text-sm text-muted-foreground mb-4">{translations.home.knowledgeGraphDesc}</p>
            <span class="text-sm font-medium text-crimson-700">{translations.home.viewKnowledgeGraph}</span>
          </div>
        </div>
      </a>
    </div>
  </section>

  <!-- Latest Blog Posts -->
  <section class="container mx-auto px-4 py-10 sm:py-16 md:py-20">
    <FadeIn client:load>
      <div class="text-center mb-8 sm:mb-10 md:mb-12">
        <h2 class="font-serif text-2xl sm:text-3xl md:text-4xl font-bold mb-4 text-foreground tracking-tight">{translations.home.latestPosts}</h2>
        <div class="editorial-divider mb-4"></div>
        <p class="text-base sm:text-lg text-muted-foreground max-w-xl mx-auto">{translations.home.latestPostsDesc}</p>
      </div>
    </FadeIn>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {sortedPosts.map((post) => (
        <BlogCard
          client:visible
          title={post.frontmatter.title}
          description={post.frontmatter.description}
          date={post.frontmatter.date}
          readTime={post.frontmatter.readTime}
          tags={post.frontmatter.tags}
          slug={post.frontmatter.slug}
          locale={locale}
        />
      ))}
    </div>
    <FadeIn client:load className="text-center mt-8">
      <Button asChild variant="outline" size="lg">
        <a href={getLocalizedPath('/blog', locale)}>{translations.home.viewAllPosts}</a>
      </Button>
    </FadeIn>
  </section>
</Layout>
