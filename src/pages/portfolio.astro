---
import Layout from '../layouts/Layout.astro';
import { PortfolioFilter } from '../components/PortfolioFilter';
import { FadeIn } from '../components/animations/FadeIn';
import { projects } from '../data/profile';
---

<Layout title="ポートフォリオ | Tech Blog" description="制作したプロジェクトの一覧">
  <section class="container mx-auto px-4 py-20">
    <FadeIn client:load>
      <div class="text-center mb-16">
        <h1 class="text-5xl font-bold mb-6">
          <span class="bg-gradient-to-r from-primary via-purple-600 to-pink-600 bg-clip-text text-transparent">
            ポートフォリオ
          </span>
        </h1>
        <p class="text-xl text-muted-foreground max-w-2xl mx-auto">
          これまでに制作したプロジェクトをご覧ください。フィルターで技術スタック別に絞り込むことができます。
        </p>
      </div>
    </FadeIn>

    <PortfolioFilter client:load projects={projects} />
  </section>

  <!-- Stats Section -->
  <section class="container mx-auto px-4 py-20 bg-muted/30 rounded-3xl mt-20">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
      <FadeIn client:visible delay={0}>
        <div>
          <div class="text-5xl font-bold text-primary mb-2">{projects.length}+</div>
          <div class="text-xl text-muted-foreground">プロジェクト</div>
        </div>
      </FadeIn>
      <FadeIn client:visible delay={0.1}>
        <div>
          <div class="text-5xl font-bold text-purple-600 mb-2">
            {Array.from(new Set(projects.flatMap(p => p.tags))).length}+
          </div>
          <div class="text-xl text-muted-foreground">技術スタック</div>
        </div>
      </FadeIn>
      <FadeIn client:visible delay={0.2}>
        <div>
          <div class="text-5xl font-bold text-pink-600 mb-2">
            {projects.filter(p => p.featured).length}
          </div>
          <div class="text-xl text-muted-foreground">注目プロジェクト</div>
        </div>
      </FadeIn>
    </div>
  </section>
</Layout>
