---
import Layout from '../layouts/Layout.astro';
import { PortfolioFilter } from '../components/PortfolioFilter';
import { FadeIn } from '../components/animations/FadeIn';
import { getLocalizedProfile } from '../data/profile-i18n';
import { getLocaleFromPath } from '../i18n/utils';
import { getTranslations } from '../i18n';
import type { SupportedLocale } from '../types';

const locale: SupportedLocale = getLocaleFromPath(Astro.url.pathname);
const translations = getTranslations(locale);
const { projects } = getLocalizedProfile(locale);
---

<Layout title={`${translations.portfolio.title} | tosh.sh`} description={translations.portfolio.description}>
  <section class="container mx-auto px-4 py-10 sm:py-16 md:py-20">
    <FadeIn client:load>
      <div class="text-center mb-10 sm:mb-12 md:mb-16">
        <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl font-bold mb-4 tracking-tight">
          {translations.portfolio.title}
        </h1>
        <div class="editorial-divider mb-4"></div>
        <p class="text-base sm:text-lg text-muted-foreground max-w-2xl mx-auto">
          {translations.portfolio.browseDesc}
        </p>
      </div>
    </FadeIn>

    <PortfolioFilter client:load projects={projects} />
  </section>

  <!-- Stats Section -->
  <section class="container mx-auto px-4 py-10 sm:py-16 md:py-20 bg-muted/30 rounded-2xl sm:rounded-3xl mt-10 sm:mt-16 md:mt-20">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 sm:gap-8 text-center">
      <FadeIn client:visible delay={0}>
        <div>
          <div class="text-3xl sm:text-4xl md:text-5xl font-bold font-serif text-foreground mb-2">{projects.length}+</div>
          <div class="text-base sm:text-lg md:text-xl text-muted-foreground">{translations.portfolio.projects}</div>
        </div>
      </FadeIn>
      <FadeIn client:visible delay={0.1}>
        <div>
          <div class="text-3xl sm:text-4xl md:text-5xl font-bold font-serif text-crimson-500 mb-2">
            {Array.from(new Set(projects.flatMap(p => p.tags))).length}+
          </div>
          <div class="text-base sm:text-lg md:text-xl text-muted-foreground">{translations.portfolio.techStacks}</div>
        </div>
      </FadeIn>
      <FadeIn client:visible delay={0.2}>
        <div>
          <div class="text-3xl sm:text-4xl md:text-5xl font-bold font-serif text-crimson-700 mb-2">
            {projects.filter(p => p.featured).length}
          </div>
          <div class="text-base sm:text-lg md:text-xl text-muted-foreground">{translations.portfolio.featuredProjects}</div>
        </div>
      </FadeIn>
    </div>
  </section>
</Layout>
