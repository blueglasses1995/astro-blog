---
import Layout from '../../layouts/Layout.astro';
import { BlogCard } from '../../components/BlogCard';
import type { BlogListItem } from '../../components/BlogFilterPanel';

import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  // Helper to process posts
  const processPosts = (allPosts: any[]) => {
    return allPosts
      .map((post) => {
        const data = post.data;
        const slug = post.slug;
        const createdDate = data.date ? data.date.toISOString() : (data.pubDate ? data.pubDate.toISOString() : '');
        const updatedDate = data.updatedDate ? data.updatedDate.toISOString() : createdDate;

        return {
          title: data.title,
          description: data.description,
          date: createdDate,
          updatedDate,
          readTime: data.readTime,
          tags: data.tags ?? [],
          slug,
          category: data.category,
        } satisfies BlogListItem;
      })
      .filter((post) => Boolean(post.slug && post.title && post.date))
      .sort((a, b) => new Date(b.updatedDate ?? b.date).getTime() - new Date(a.updatedDate ?? a.date).getTime());
  };

  const allProcessedPosts = processPosts(posts) as BlogListItem[];

  // Get unique tags
  const tags = new Set<string>();
  allProcessedPosts.forEach((post) => {
    if (post.tags) {
      post.tags.forEach(tag => tags.add(tag));
    }
  });

  return Array.from(tags).map((tag) => {
    // Filter posts for this tag
    const filteredPosts = allProcessedPosts.filter(post => post.tags?.includes(tag));

    return {
      params: { tag },
      props: { posts: filteredPosts, tag },
    };
  });
}

interface Props {
  posts: BlogListItem[];
  tag: string;
}

const { posts, tag } = Astro.props;
---

<Layout title={`Tag: ${tag} | tosh.sh`}>
  <section class="container mx-auto px-4 py-16">
    <div class="mb-12">
      <div class="flex items-center gap-2 mb-4">
        <a href="/blog" class="text-muted-foreground hover:text-primary transition-colors">
          ← ブログ
        </a>
      </div>
      <h1 class="text-4xl font-bold mb-4">Tag: {tag}</h1>
      <p class="text-muted-foreground">{posts.length} 件の記事</p>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((post: BlogListItem) => {
        const displayDate = post.updatedDate ? post.updatedDate : post.date;
        return (
          <BlogCard
            title={post.title}
            description={post.description}
            date={displayDate}
            readTime={post.readTime ?? ''}
            tags={post.tags ?? []}
            slug={post.slug}
            locale="ja"
            updatedDate={post.updatedDate}
          />
        );
      })}
    </div>
  </section>
</Layout>
